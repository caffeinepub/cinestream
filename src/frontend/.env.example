# TMDB API Key (optional - app works without it using fallback key)
# Get your free API key from https://www.themoviedb.org/settings/api
# 
# Benefits of using your own key:
# - Higher rate limits
# - Better reliability for production
# - No shared quota with other users
#
# The app will work without this variable using a demo fallback key
VITE_TMDB_API_KEY=your_tmdb_api_key_here
